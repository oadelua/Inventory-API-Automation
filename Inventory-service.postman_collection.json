		{
			"name": "Get merchant product list",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							" const Ajv = require('ajv');\r",
							" const ajv = new Ajv({ allErrors: true }); \r",
							" var response = pm.response.json();\r",
							" \r",
							"pm.test(\"Verify status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"// Validate the JSON schema of API response\r",
							"pm.test(\"Validate the JSON schema of the API response\", function () {\r",
							"    var schema = {\r",
							"        type: \"object\",\r",
							"        properties: {\r",
							"            success: { type: \"boolean\" },\r",
							"            message: { type: \"string\" },\r",
							"            internalCode: { type: \"string\" },\r",
							"            dateTime: { type: \"string\" },\r",
							"            data: {\r",
							"                type: \"object\",\r",
							"                properties: {\r",
							"                    content: {\r",
							"                        type: \"array\",\r",
							"                        items: {\r",
							"                            type: \"object\",\r",
							"                            properties: {\r",
							"                                documentId: { type: \"string\" },\r",
							"                                price: { type: \"number\" },\r",
							"                                lowStockThreshold: { type: \"number\" },\r",
							"                                stockLevel: { type: \"number\" },\r",
							"                                lowInStock: { type: \"boolean\" },\r",
							"                                baseProduct: {\r",
							"                                    type: \"object\",\r",
							"                                    properties: {\r",
							"                                        documentId: { type: \"string\" },\r",
							"                                        name: { type: \"string\" },\r",
							"                                        unitOfMeasurement: { type: \"string\" },\r",
							"                                        imageUrl: { type: \"string\" }\r",
							"                                    },\r",
							"                                    required: [\"documentId\", \"name\", \"unitOfMeasurement\", \"imageUrl\"]\r",
							"                                }\r",
							"                            },\r",
							"                            required: [\"documentId\", \"price\", \"lowStockThreshold\", \"stockLevel\", \"lowInStock\", \"baseProduct\"]\r",
							"                        }\r",
							"                    },\r",
							"                    totalPages: { type: \"number\" },\r",
							"                    totalItems: { type: \"number\" },\r",
							"                    totalItemsCurrentPage: { type: \"number\" },\r",
							"                    currentPage: { type: \"number\" },\r",
							"                    empty: { type: \"boolean\" },\r",
							"                    lastPage: { type: \"boolean\" },\r",
							"                    firstPage: { type: \"boolean\" }\r",
							"                },\r",
							"                required: [\"content\", \"totalPages\", \"totalItems\", \"totalItemsCurrentPage\", \"currentPage\", \"empty\", \"lastPage\", \"firstPage\"]\r",
							"            }\r",
							"        },\r",
							"        required: [\"success\", \"message\", \"internalCode\", \"dateTime\", \"data\"]\r",
							"    };\r",
							"\r",
							"    const validate = ajv.compile(schema);\r",
							"    pm.expect(validate(response),JSON.stringify(schema)).to.be.true;\r",
							"});\r",
							"\r",
							"//set single added product id\r",
							"  let jsonData = response.data.content\r",
							"  let singleProduct = jsonData.filter(product=>\r",
							"    product.baseProduct && product.baseProduct.name.includes(\"Chocolate\")\r",
							"  ).map(item=>\r",
							"        item.baseProduct.documentId)\r",
							"    pm.environment.set(\"productId\", singleProduct[0])\r",
							"    console.log(\"product\",singleProduct[0])\r",
							"\r",
							"//set bulk product ids\r",
							"  let bulkProducts = jsonData.filter(product=>product.baseProduct.name.includes(\"Gari Mix\" ))\r",
							"  .map(item=>item.baseProduct.documentId)\r",
							"    pm.environment.set(\"bulk_upload_productIds\", bulkProducts)"
						],
